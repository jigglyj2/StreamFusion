<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>tech.streamfusion</groupId>
        <artifactId>streamfusion-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>streamfusion-native</artifactId>
    <packaging>jar</packaging>
    <name>StreamFusion : Native DataFusion Runtime</name>

    <dependencies>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-proto</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.maven.plugin.version}</version>
                <executions>
                    <execution>
                        <id>cargo-build</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>cargo</executable>
                            <arguments>
                                <argument>build</argument>
                                <argument>--release</argument>
                                <argument>--locked</argument>
                            </arguments>
                            <environmentVariables>
                                <CARGO_TARGET_DIR>${project.build.directory}/rust</CARGO_TARGET_DIR>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cargo-test</id>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>cargo</executable>
                            <arguments>
                                <argument>test</argument>
                                <argument>--locked</argument>
                            </arguments>
                            <environmentVariables>
                                <CARGO_TARGET_DIR>${project.build.directory}/rust</CARGO_TARGET_DIR>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>${project.build.directory}/rust/release</directory>
                <targetPath>META-INF/native/linux-x86_64</targetPath>
                <includes>
                    <include>libstreamfusion_native.so</include>
                </includes>
            </resource>
        </resources>
    </build>
</project>
