diff --git a/src/db_options.rs b/src/db_options.rs
index 9d535b4..89a1b6a 100644
--- a/src/db_options.rs
+++ b/src/db_options.rs
@@ -4036,0 +4037,14 @@ impl LruCacheOptions {
+    /// Fraction of cache capacity reserved for high-priority entries, between zero and one.
+    ///
+    /// Panics if the ratio is outside that interval or is NaN. The default is 0.5.
+    #[cfg(feature = "cache-priority")]
+    pub fn set_high_pri_pool_ratio(&mut self, ratio: f64) {
+        assert!(
+            (0.0..=1.0).contains(&ratio),
+            "cache priority ratio must be between zero and one"
+        );
+        unsafe {
+            ffi::rocksdb_lru_cache_options_set_high_pri_pool_ratio(self.inner, ratio);
+        }
+    }
+
