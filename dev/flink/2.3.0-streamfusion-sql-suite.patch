diff --git a/flink-table/flink-table-planner/src/test/java/org/apache/flink/table/planner/utils/StreamFusionPlannerTestAccess.java b/flink-table/flink-table-planner/src/test/java/org/apache/flink/table/planner/utils/StreamFusionPlannerTestAccess.java
new file mode 100644
--- /dev/null
+++ b/flink-table/flink-table-planner/src/test/java/org/apache/flink/table/planner/utils/StreamFusionPlannerTestAccess.java
@@ -0,0 +1,29 @@
+/*
+ * Copyright 2026 StreamFusion Authors
+ * Licensed under the Apache License, Version 2.0.
+ */
+package org.apache.flink.table.planner.utils;
+
+import org.apache.flink.table.delegation.Planner;
+import org.apache.flink.table.planner.delegation.PlannerBase;
+
+/** Test-only access to Flink planning internals; execution keeps the installed facade. */
+public final class StreamFusionPlannerTestAccess {
+    private StreamFusionPlannerTestAccess() {}
+
+    public static PlannerBase unwrap(Planner planner) {
+        if (planner instanceof PlannerBase) {
+            return (PlannerBase) planner;
+        }
+        if (!planner.getClass().getName().equals("tech.streamfusion.flink.StreamFusionPlanner")) {
+            throw new IllegalArgumentException("Unsupported test planner: " + planner.getClass());
+        }
+        try {
+            var delegate = planner.getClass().getDeclaredField("delegate");
+            delegate.setAccessible(true);
+            return (PlannerBase) delegate.get(planner);
+        } catch (ReflectiveOperationException failure) {
+            throw new IllegalStateException("Cannot inspect StreamFusion's Flink planner", failure);
+        }
+    }
+}
