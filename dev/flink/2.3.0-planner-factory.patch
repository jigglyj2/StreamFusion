@@ -29,9 +29,14 @@ import org.apache.flink.table.delegation.PlannerFactory.Context;
 import org.apache.flink.table.delegation.PlannerFactory.DefaultPlannerContext;
 import org.apache.flink.table.module.ModuleManager;
 
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+
 /** Utility for discovering and instantiating {@link PlannerFactory}. */
 @Internal
 public class PlannerFactoryUtil {
+    private static final String PLANNER_FACTORY_PROPERTY =
+            "tech.streamfusion.flink.planner.factory";
 
     /** Discovers a planner factory and creates a planner instance. */
     public static Planner createPlanner(
@@ -55,7 +60,28 @@ public class PlannerFactoryUtil {
                         moduleManager,
                         catalogManager,
                         functionCatalog);
-        return plannerFactory.create(context);
+        return decoratePlanner(plannerFactory.create(context));
+    }
+
+    private static Planner decoratePlanner(Planner planner) {
+        final String decoratorClass = System.getProperty(PLANNER_FACTORY_PROPERTY);
+        if (decoratorClass == null || decoratorClass.isBlank()) {
+            return planner;
+        }
+        try {
+            final Method decorate =
+                    Class.forName(
+                                    decoratorClass,
+                                    true,
+                                    Thread.currentThread().getContextClassLoader())
+                            .getMethod("decorate", Planner.class);
+            return (Planner) decorate.invoke(null, planner);
+        } catch (ClassNotFoundException | NoSuchMethodException | IllegalAccessException e) {
+            throw new IllegalStateException(
+                    "Could not invoke planner decorator " + decoratorClass, e);
+        } catch (InvocationTargetException e) {
+            throw new IllegalStateException("Planner decoration failed", e.getCause());
+        }
     }
 
     private PlannerFactoryUtil() {}
