+    private static PlannerFactory discoverPlannerFactory() {
+        final ClassLoader classLoader = Thread.currentThread().getContextClassLoader();
+        final String plannerFactoryClass = System.getProperty(PLANNER_FACTORY_PROPERTY);
+        if (plannerFactoryClass == null || plannerFactoryClass.isBlank()) {
+            return FactoryUtil.discoverFactory(
+                    classLoader, PlannerFactory.class, PlannerFactory.DEFAULT_IDENTIFIER);
+        }
+
+        try {
+            return Class.forName(plannerFactoryClass, true, classLoader)
+                    .asSubclass(PlannerFactory.class)
+                    .getDeclaredConstructor()
+                    .newInstance();
+        } catch (ReflectiveOperationException e) {
+            throw new IllegalStateException(
+                    String.format(
+                            "Could not create planner factory '%s' configured by system property '%s'.",
+                            plannerFactoryClass, PLANNER_FACTORY_PROPERTY),
+                    e);
+        }
+    }
+
     private PlannerFactoryUtil() {}
 }
